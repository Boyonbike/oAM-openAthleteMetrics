{
  "id": "hume_band_v1",
  "displayName": "Hume Band",
  "version": "1.0.0",
  "author": "Open Athlete Metrics",
  "supportedMetrics": ["HR", "HRV", "SPO2", "STEPS", "BATTERY"],

  "ble": {
    "matchByName": "HumeBand",
    "matchByServiceUuid": "0000fee0-0000-1000-8000-00805f9b34fb",
    "matchConfidence": "CERTAIN",
    "services": [
      "0000fee0-0000-1000-8000-00805f9b34fb"
    ],
    "characteristics": {
      "notify": "0000fee1-0000-1000-8000-00805f9b34fb",
      "write":  "0000fee2-0000-1000-8000-00805f9b34fb"
    }
  },

  "syncCommands": [
    {
      "type": "ENABLE_NOTIFY",
      "characteristic": "notify"
    },
    {
      "type": "WRITE",
      "characteristic": "write",
      "bytes": "0x01 0x00"
    },
    {
      "type": "DELAY",
      "millis": 200
    },
    {
      "type": "WRITE",
      "characteristic": "write",
      "bytes": "0x02 0x00"
    }
  ],

  "parsing": {
    "mode": "JSON",
    "rules": [
      {
        "characteristic": "notify",
        "match": {
          "byte": 0,
          "value": "0x04"
        },
        "fields": [
          {
            "metric": "HR",
            "byteOffset": 1,
            "byteLength": 1,
            "signed": false,
            "unit": "bpm"
          },
          {
            "metric": "SPO2",
            "byteOffset": 2,
            "byteLength": 1,
            "signed": false,
            "unit": "%"
          }
        ]
      },
      {
        "characteristic": "notify",
        "match": {
          "byte": 0,
          "value": "0x06"
        },
        "fields": [
          {
            "metric": "STEPS",
            "byteOffset": 1,
            "byteLength": 3,
            "signed": false,
            "unit": "steps"
          }
        ]
      },
      {
        "characteristic": "notify",
        "match": {
          "byte": 0,
          "value": "0x0A"
        },
        "fields": [
          {
            "metric": "HRV",
            "byteOffset": 1,
            "byteLength": 2,
            "signed": false,
            "scale": 0.1,
            "unit": "ms"
          },
          {
            "metric": "BATTERY",
            "byteOffset": 3,
            "byteLength": 1,
            "signed": false,
            "unit": "%"
          }
        ]
      }
    ]
  }
}
