<?xml version="1.0" encoding="utf-8"?>
<!-- Medium tier: wide and short, targets a 2x1 launcher cell. Minimum resize floor is the small tier. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="90dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="90dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:configure="com.athletedata.openAthleteMetrics.glance.WidgetConfigActivity"
    android:initialLayout="@layout/glance_default_loading_layout" />
