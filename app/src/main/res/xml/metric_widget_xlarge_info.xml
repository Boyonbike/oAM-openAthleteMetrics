<?xml version="1.0" encoding="utf-8"?>
<!-- XLarge tier: targets a 2x4 launcher cell, for Sleep Summary Large. Minimum resize floor is the large tier. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="360dp"
    android:targetCellWidth="2"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:configure="com.athletedata.openAthleteMetrics.glance.WidgetConfigActivity"
    android:initialLayout="@layout/glance_default_loading_layout" />
